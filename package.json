{
  "name": "barrio",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply barrio --local",
    "db:seed": "wrangler d1 execute barrio --local --file=./scripts/seed.sql",
    "db:reset:local": "npm run db:migrate:local && npm run db:seed",
    "deploy": "npm run build && wrangler deploy",
    "cf:typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "4.6.14",
    "jose": "5.9.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router-dom": "7.1.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20241230.0",
    "@types/node": "22.13.4",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.7.3",
    "vite": "6.2.0",
    "vitest": "3.0.5",
    "wrangler": "3.99.0"
  }
}
