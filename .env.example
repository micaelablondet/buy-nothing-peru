# Prototype uses mock data only. No secrets required for local dev.
# GitHub Pages sets these automatically in .github/workflows/deploy-pages.yml
# VITE_BASE_PATH=/buy-nothing-peru/
# VITE_APP_PUBLIC_URL=https://YOUR_USER.github.io/buy-nothing-peru
# App Store / Play Store listings (used by Invita a un amigx share)
# VITE_APP_IOS_STORE_URL=https://apps.apple.com/app/idXXXXXXXXX
# VITE_APP_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=io.barrio.app
